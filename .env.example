# Copy to .env for local-only values. Never commit .env.
#
# Example:
# MODEL_PROVIDER_API_KEY=
# EXPERIMENT_TRACKING_TOKEN=
# RUNPOD_API_KEY=  # Mac-side watchdog, supervisor and identity/billing capture only; never commit an actual key.
# Inside a Runpod Pod this variable is injected automatically as a Pod-scoped key.
